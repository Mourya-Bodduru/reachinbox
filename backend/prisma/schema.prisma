datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EmailJobStatus {
  SCHEDULED
  QUEUED
  SENDING
  SENT
  FAILED
  RATE_LIMITED_RESCHEDULED
  CANCELLED
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  name             String?
  avatar           String?
  googleId         String?    @unique
  slackWebhookUrl  String?
  slackAccessToken String?
  slackChannel     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  emailJobs        EmailJob[]
}

model Sender {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  host      String?
  port      Int?
  user      String?
  pass      String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailJob {
  id                 String         @id @default(uuid())
  userId             String?
  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  senderEmail        String
  recipientEmail     String
  subject            String
  body               String         @db.Text
  status             EmailJobStatus @default(SCHEDULED)
  scheduledAt        DateTime
  sentAt             DateTime?
  failedAt           DateTime?
  errorMessage       String?        @db.Text
  etherealPreviewUrl String?        @db.Text
  bullmqJobId        String?
  attemptCount       Int            @default(0)
  hourlyLimit        Int            @default(50)
  delaySeconds       Int            @default(2)
  batchId            String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status])
  @@index([senderEmail])
  @@index([scheduledAt])
  @@index([recipientEmail])
  @@index([batchId])
}

model RateLimitLog {
  id            String   @id @default(uuid())
  senderEmail   String
  hourWindowKey String
  count         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([senderEmail, hourWindowKey])
}
